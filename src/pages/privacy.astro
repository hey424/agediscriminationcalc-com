---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Privacy Policy | agediscriminationcalc.com';
const description = 'Privacy policy for agediscriminationcalc.com — data collection, cookies, and third-party services.';
---
<BaseLayout title={title} description={description}>
  <h1>Privacy Policy</h1>
  <p><strong>Effective date:</strong> January 1, 2026</p>

  <h2>Information we collect</h2>
  <p>agediscriminationcalc.com does not collect personal information directly. We do not require account creation, email submission, or any form completion to use the calculator or read the guides. All calculator inputs are processed locally in your browser and are not transmitted to our servers.</p>

  <h2>Cookies and advertising</h2>
  <p>This site uses Google AdSense to display advertisements. Google AdSense sets cookies to serve relevant advertisements based on your browsing activity. These cookies are set by Google, not by agediscriminationcalc.com, and are governed by Google&rsquo;s privacy policy. You can manage your Google advertising preferences at <a href="https://adssettings.google.com" target="_blank" rel="noopener">adssettings.google.com</a>.</p>

  <h2>Analytics</h2>
  <p>We use Google Analytics to collect aggregate, anonymized traffic data — page views, session counts, and general geographic distribution. This data is used only to understand usage patterns and is not used to identify individual visitors.</p>

  <h2>Third-party services</h2>
  <p>The only third-party services active on this site are Google AdSense and Google Analytics. Both are operated by Google LLC and subject to Google&rsquo;s <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</p>

  <h2>Your choices</h2>
  <p>You can opt out of Google interest-based advertising at <a href="https://adssettings.google.com" target="_blank" rel="noopener">Google Ad Settings</a>. You can prevent Google Analytics data collection by installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google Analytics Opt-out Browser Add-on</a>.</p>

  <h2>Contact</h2>
  <p>Questions about this policy? Email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>
</BaseLayout>
