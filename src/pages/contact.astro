---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Contact | agediscriminationcalc.com';
const description = 'Contact the agediscriminationcalc.com editorial team with corrections, feedback, or questions.';
---
<BaseLayout title={title} description={description}>
  <h1>Contact</h1>
  <p>For corrections, feedback, or questions about the calculator or guides, email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>
  <p>We read every message and take accuracy seriously. If you have found a factual error, an outdated legal reference, or a calculation result that appears incorrect, please include the specific page URL and the detail you believe is wrong. We review and correct confirmed errors promptly.</p>
  <p>We are not able to provide legal advice or evaluate your specific ADEA situation. If you believe you have experienced age discrimination, please consult a licensed employment attorney in your state as soon as possible. The EEOC filing deadline — 180 or 300 days from the discriminatory act — is strictly enforced, and missing it typically bars your federal claim. Many employment attorneys handle ADEA cases on contingency, with no fee unless you recover.</p>
</BaseLayout>
